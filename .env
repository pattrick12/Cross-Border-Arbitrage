# Infrastructure
REDPANDA_BROKER=localhost:19092
QUESTDB_HTTP=http://localhost:9000
QUESTDB_INGEST=localhost:9009
QUESTDB_PG=localhost:8812

# Flink
FLINK_JOBMANAGER=localhost:8081

# OANDA Configuration (not used in mock mode)
OANDA_ENV=practice
OANDA_TOKEN=replace_with_your_token
OANDA_ACCOUNT_ID=replace_with_your_account_id

# App Settings
LOG_LEVEL=INFO

# ML / Model
MODEL_DIR=./models
LSTM_SEQUENCE_LENGTH=60
XGBOOST_N_ESTIMATORS=200

# Risk Parameters
MONTE_CARLO_PATHS=10000
CVAR_CONFIDENCE=0.95
MAX_KELLY_FRACTION=0.5
MAX_POSITION_PCT=0.10

# Streaming
OHLCV_WINDOW_SEC=60
CORRELATION_WINDOW_TICKS=300